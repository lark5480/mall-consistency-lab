# 复制为 .env（git 已忽略）按需覆盖本地 Compose 行为；不设任何值也能直接 docker compose up
# Compose 变量替换的默认值均写在 docker-compose.yml 内（${VAR:-default} 形式）

# Docker Compose 2.x 在部分 Windows/老版本组合下禁用 bake 构建器（规避构建异常）
COMPOSE_BAKE=false

# 首页 Redis 宿主机端口映射（默认 6379；本机已有 Redis 占用时改成 16379 等）
# REDIS_HOST_PORT=16379

# product 孤儿扣减对账参数（默认见 compose）
# RECONCILE_STALE_MINUTES=10
# RECONCILE_INTERVAL_MS=300000

# order 超时自动收货参数（默认见 compose）
# AUTO_COMPLETE_DAYS=7
# AUTO_COMPLETE_INTERVAL_MS=300000
